[Unit]
Description=Drawing Agent image pull webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/drawing-agent/image-pull-webhook.env
ExecStart=/usr/local/bin/image-pull-webhook
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
