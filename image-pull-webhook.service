[Unit]
Description=Container image pull webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Environment=HOME=@SERVICE_HOME@
Environment=XDG_RUNTIME_DIR=/run/user/@SERVICE_UID@
EnvironmentFile=/etc/drawing-agent/image-pull-webhook.env
ExecStart=/usr/local/bin/image-pull-webhook
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=@PROTECT_HOME@

[Install]
WantedBy=multi-user.target
