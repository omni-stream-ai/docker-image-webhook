WEBHOOK_SECRET=replace-with-a-long-random-secret
WEBHOOK_LISTEN_ADDR=127.0.0.1:19090
WEBHOOK_CONTAINER_ENGINE=podman
WEBHOOK_ALLOWED_REPOSITORIES=ghcr.io/namespace/repo-test
# Alternatively, pin every accepted event to one registry repository:
# WEBHOOK_IMAGE_REPOSITORY=ghcr.io/namespace/repo-test
# Only required for legacy Alibaba Cloud Container Registry events without an image field:
# WEBHOOK_REGISTRY_TEMPLATE=registry.%s.aliyuncs.com
# WEBHOOK_PULL_TIMEOUT=10m
# Run only after a successful pull. The command receives WEBHOOK_IMAGE.
# WEBHOOK_POST_PULL_COMMAND=/usr/local/bin/redeploy-my-app
